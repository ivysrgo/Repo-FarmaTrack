<%# views/sistema/reportes.ejs — Catálogo de reportes disponibles %>

<header class="topbar">
  <div class="topbar__left">
    <nav class="breadcrumb">
      <span class="breadcrumb__link">Inicio</span>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">Reportes</span>
    </nav>
  </div>
  <div class="topbar__right">
    <div class="topbar__date"><%= fechaHoy %></div>
    <div class="avatar topbar__avatar"><%= usuario.iniciales %></div>
  </div>
</header>

<div class="sec-page">

  <div class="sec-page__head">
    <h1 class="sec-page__title">Reportes</h1>
    <p class="sec-page__sub">Reportes disponibles para descarga y para presentación a INVIMA.</p>
  </div>

  <div class="reportes-grid">
    <% reportes.forEach(function(r) { %>
      <div class="reporte-card">
        <div class="reporte-card__icon"><%= r.icono %></div>
        <div class="reporte-card__body">
          <h3 class="reporte-card__title"><%= r.titulo %></h3>
          <p class="reporte-card__desc"><%= r.descripcion %></p>
          <p class="reporte-card__meta"><%= r.meta %></p>
        </div>
        <button class="reporte-card__btn" disabled title="Próximamente — la generación PDF llega cuando estemos contra MongoDB">
          Generar reporte
        </button>
      </div>
    <% }) %>
  </div>

  <div class="sec-card" style="margin-top:var(--sp4);">
    <p class="sec-card__title">Próximamente</p>
    <p class="sec-card__sub">
      Los reportes se generarán como PDF descargable con firma del Director Técnico.
      La función de generación se habilita cuando los datos provengan de MongoDB en
      lugar del repositorio en memoria.
    </p>
  </div>

</div>

<style>
  .reportes-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp4);
  }
  .reporte-card {
    background: var(--white); border: 0.5px solid var(--border); border-radius: 10px;
    padding: var(--sp4); display: flex; flex-direction: column; gap: var(--sp3);
    min-height: 180px;
  }
  .reporte-card__icon { font-size: 28px; line-height: 1; }
  .reporte-card__body { flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .reporte-card__title { font-size: 15px; font-weight: var(--fw-medium); color: var(--text); }
  .reporte-card__desc  { font-size: var(--fs-label); color: var(--muted); line-height: 1.5; }
  .reporte-card__meta  { font-size: var(--fs-hint);  color: var(--green-dark); font-weight: var(--fw-medium); }
  .reporte-card__btn {
    align-self: flex-start;
    background: var(--green-dark); color: #fff; border: 0.5px solid var(--green-dark);
    padding: 8px 16px; border-radius: 8px;
    font-size: 12px; font-weight: var(--fw-medium); cursor: pointer;
    font-family: var(--font); transition: opacity 0.15s;
  }
  .reporte-card__btn:hover:not([disabled]) { opacity: 0.9; }
  .reporte-card__btn[disabled] {
    background: var(--input-bg); color: var(--muted); border-color: var(--border);
    cursor: not-allowed;
  }
  @media (max-width: 1100px) {
    .reportes-grid { grid-template-columns: 1fr; }
  }
</style>
