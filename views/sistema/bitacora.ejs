<%# views/sistema/bitacora.ejs — Bitácora de eventos del sistema %>

<header class="topbar">
  <div class="topbar__left">
    <nav class="breadcrumb">
      <span class="breadcrumb__link">Inicio</span>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">Bitácora</span>
    </nav>
  </div>
  <div class="topbar__right">
    <div class="topbar__date"><%= fechaHoy %></div>
    <div class="avatar topbar__avatar"><%= usuario.iniciales %></div>
  </div>
</header>

<div class="sec-page">

  <div class="sec-page__head">
    <h1 class="sec-page__title">Bitácora</h1>
    <p class="sec-page__sub">
      <% if (esOperario) { %>
        Tus eventos recientes y los eventos del sistema que afectan tus lotes.
      <% } else { %>
        Registro cronológico de todas las acciones en el sistema (lotes, firmas, alertas BPM, NC).
      <% } %>
    </p>
  </div>

  <div class="sec-card">
    <p class="sec-card__title">Eventos recientes</p>
    <p class="sec-card__sub">
      <%= eventos.length %> evento<%= eventos.length === 1 ? '' : 's' %> registrado<%= eventos.length === 1 ? '' : 's' %>.
      <% if (!esOperario) { %>
        En la versión final habrá filtros por fecha, tipo, usuario y lote.
      <% } %>
    </p>

    <% if (eventos.length === 0) { %>
      <div class="sec-empty">No hay eventos registrados todavía.</div>
    <% } else { %>
      <ul class="bitacora-list">
        <% eventos.forEach(function(ev) { %>
          <li class="bitacora-row">
            <span class="bitacora-row__dot bitacora-row__dot--<%= ev.tipo %>"></span>
            <div class="bitacora-row__body">
              <span class="bitacora-row__text"><%= ev.texto %></span>
              <span class="bitacora-row__meta">
                <%= ev.fecha %> · <%= ev.usuario %>
                <% if (ev.lote) { %>
                  ·
                  <% if (ev.loteHref) { %>
                    <a href="<%= ev.loteHref %>" class="sec-link"><%= ev.lote %><% if (ev.paso) { %> · paso <%= ev.paso %><% } %></a>
                  <% } else { %>
                    <span><%= ev.lote %></span>
                  <% } %>
                <% } %>
              </span>
            </div>
            <% if (ev.puedeResolver) { %>
              <form action="/noconformidad/<%= ev.ncId %>/resolver" method="POST" class="bitacora-row__action">
                <input type="hidden" name="redirectTo" value="/bitacora" />
                <button type="submit" class="btn-resolver" title="Marcar esta NC como resuelta">
                  ✓ Marcar resuelta
                </button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

</div>

<style>
  /* Estilos específicos de la bitácora */
  .bitacora-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .bitacora-row {
    display: flex; gap: 12px; align-items: center;
    padding: 10px 12px; border-radius: 8px;
    transition: background 0.15s;
  }
  .bitacora-row:hover { background: rgba(93, 202, 165, 0.04); }
  .bitacora-row__dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--green-mid); margin-top: 5px; flex-shrink: 0;
    align-self: flex-start;
  }
  .bitacora-row__dot--warning { background: #c5c930; }
  .bitacora-row__dot--alert   { background: #E24B4A; }
  .bitacora-row__dot--info    { background: var(--blue-av); }
  .bitacora-row__body { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .bitacora-row__text { font-size: 12px; color: var(--text); }
  .bitacora-row__meta { font-size: 10px; color: var(--muted); }

  /* Botón "Marcar resuelta" pegado a la derecha de cada evento de NC abierta */
  .bitacora-row__action { margin: 0; margin-left: auto; flex-shrink: 0; }
  .btn-resolver {
    display: inline-flex; align-items: center; gap: 6px;
    height: 30px; padding: 0 14px;
    font-family: var(--font, inherit); font-size: 11px; font-weight: 600;
    color: var(--green-dark, #2f5e4f);
    background: var(--nude, #f2ece1);
    border: 1px solid var(--green-dark, #2f5e4f);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.05s;
    white-space: nowrap;
  }
  .btn-resolver:hover { background: var(--green-dark, #2f5e4f); color: #fff; }
  .btn-resolver:active { transform: translateY(1px); }
</style>
