<%# views/auth/recuperar.ejs — Recuperar contraseña (placeholder demo) %>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; background:var(--nude);">
  <div style="width:100%; max-width:420px; background:#fff; border-radius:14px; padding:36px 40px; box-shadow:0 6px 36px rgba(0,0,0,.08);">

    <h1 style="font-size:20px; font-weight:500; color:var(--text); margin-bottom:6px;">Recuperar contraseña</h1>
    <p style="font-size:12px; color:var(--muted); margin-bottom:22px;">
      Ingresa tu correo institucional y te enviaremos las instrucciones para restablecer tu acceso.
    </p>

    <% if (typeof ok !== 'undefined' && ok && ok.length) { %>
      <div style="background:rgba(93,202,165,.12); border:.5px solid var(--green-mid); color:var(--green-dark); padding:10px 12px; border-radius:8px; font-size:11px; margin-bottom:14px;">
        ✓ <%= ok[0] %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div style="background:rgba(226,75,74,.08); border:.5px solid rgba(226,75,74,.4); color:#C42E2D; padding:10px 12px; border-radius:8px; font-size:11px; margin-bottom:14px;">
        ⚠ <%= error[0] %>
      </div>
    <% } %>

    <form action="/auth/recuperar" method="POST">
      <label for="email" style="display:block; font-size:11px; color:var(--muted); margin-bottom:4px;">Correo institucional</label>
      <input type="email" id="email" name="email" required
             placeholder="tucorreo@farmatrack.co"
             value="<%= typeof emailVal !== 'undefined' ? emailVal : '' %>"
             style="width:100%; height:40px; padding:0 12px; border:.5px solid var(--border); border-radius:8px; font-family:var(--font); font-size:13px; background:var(--input-bg); margin-bottom:16px;">

      <button type="submit" style="width:100%; height:42px; background:var(--green-dark); color:#fff; border:0; border-radius:8px; font-family:var(--font); font-size:13px; font-weight:500; cursor:pointer;">
        Enviar instrucciones
      </button>
    </form>

    <div style="margin-top:18px; text-align:center;">
      <a href="/auth/login" style="font-size:12px; color:var(--green-dark); text-decoration:none;">← Volver al inicio de sesión</a>
    </div>

  </div>
</div>
