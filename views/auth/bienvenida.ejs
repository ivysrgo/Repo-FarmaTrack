<%# Frame 5 — Bienvenida post-login (compacta, entra en 1 pantalla) %>
<%
  const u        = locals.currentUser || {};
  const nombre   = u.nombre || 'Usuario';
  const email    = u.email  || '';
  // "Última sesión" = la sesión ANTERIOR (no la actual). Null si es el primer login.
  let ultimaSesionTxt = 'Primera vez que ingresas';
  if (u.ultimaSesion) {
    const d = new Date(u.ultimaSesion);
    ultimaSesionTxt = d.toLocaleDateString('es-CO', { day:'numeric', month:'short', year:'numeric' })
                    + ' · ' + d.toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
  }
  const fechaFull = new Date().toLocaleDateString('es-CO', { day:'numeric', month:'short', year:'numeric' });
  const horaCorta = new Date().toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
  const rolesLabel = { director_tecnico:'Director Técnico — Planta Principal', operario:'Operario de Producción', calidad:'Analista de Calidad' };
  const rolLabel = rolesLabel[u.rol] || u.rol || 'Usuario';
  const dashPath = typeof dashboardPath !== 'undefined' ? dashboardPath : '/panel';
  const dashLabel = typeof dashboardLabel !== 'undefined' ? dashboardLabel.toLowerCase() : 'panel';
%>

<div class="welcome-page welcome-page--compact">
  <div class="welcome-card">
    <div class="welcome-card__accent"></div>

    <div class="welcome-card__body">

      <%# Confetti + success ring %>
      <div class="welcome-confetti">
        <span class="welcome-confetti__dot welcome-confetti__dot--y1"></span>
        <span class="welcome-confetti__dot welcome-confetti__dot--g1"></span>
        <span class="welcome-confetti__dot welcome-confetti__dot--g2"></span>
        <span class="welcome-confetti__dot welcome-confetti__dot--y2"></span>
        <span class="welcome-confetti__sq welcome-confetti__sq--1"></span>
        <span class="welcome-confetti__sq welcome-confetti__sq--2"></span>
        <div class="success-ring">
          <div class="success-ring__inner">✓</div>
        </div>
      </div>

      <h1 class="welcome-card__title">¡Bienvenido, <%= nombre.split(' ')[0] %>!</h1>
      <p class="welcome-card__sub">
        Has iniciado sesión correctamente como <%= rolLabel %>.
      </p>

      <div class="session-info">
        <div class="session-info__row">
          <span class="session-info__label">Rol</span>
          <span class="session-info__value"><%= rolLabel %></span>
        </div>
        <div class="session-info__row">
          <span class="session-info__label">Última sesión</span>
          <span class="session-info__value"><%= ultimaSesionTxt %></span>
        </div>
        <div class="session-info__row">
          <span class="session-info__label">Estado del sistema</span>
          <span class="status-badge">Operativo · Sin alertas</span>
        </div>
      </div>

      <div class="welcome-modules">
        <a href="<%= dashPath %>" class="welcome-module">
          <span class="welcome-module__icon">📋</span>
          <div class="welcome-module__body">
            <div class="welcome-module__name"><%= u.rol === 'operario' ? 'Mis lotes' : 'Panel de lotes' %></div>
            <div class="welcome-module__meta">Activos del día</div>
          </div>
          <span class="welcome-module__badge welcome-module__badge--ok">Activo</span>
        </a>
        <a href="/batch-records" class="welcome-module">
          <span class="welcome-module__icon">📄</span>
          <div class="welcome-module__body">
            <div class="welcome-module__name">Batch records</div>
            <div class="welcome-module__meta">Liberados</div>
          </div>
          <span class="welcome-module__badge welcome-module__badge--warn">Pendiente</span>
        </a>
      </div>

      <a href="<%= dashPath %>" class="ft-btn ft-btn--primary" style="width:100%; margin-bottom:8px;">
        Ir al <%= dashLabel %> →
      </a>
      <form action="/auth/logout" method="POST" style="margin:0;">
        <button type="submit" class="ft-btn ft-btn--secondary" style="width:100%;">
          Cerrar sesión
        </button>
      </form>

    </div>
  </div>
</div>
