<%# partials/stepper-footer.ejs — barra de acciones fija
     Todos los botones del lado derecho usan el estilo "secondary" (tarjeta
     blanca con borde y texto verde) para que sean visualmente consistentes
     entre sí, según el wireframe del DT en lectura. %>
<div class="step-footer">
  <div class="step-footer__left">
    <span>Solo lectura · D.T.</span>
  </div>
  <div class="step-footer__right">
    <% if (paso > 1) { %>
      <a href="/lotes/<%= lote.id %>/paso/<%= paso - 1 %>" class="btn-step btn-step--secondary">← Paso anterior</a>
    <% } %>
    <a href="/lotes/<%= lote.id %>/paso/<%= paso < 9 ? paso + 1 : 9 %>"
       class="btn-step btn-step--secondary">
      <%= paso < 9 ? 'Paso siguiente →' : 'Ver resumen' %>
    </a>
  </div>
</div>
