<%- /* views/panel/index.ejs — Panel de lotes activos (Director Técnico) RQF-06 */ %>

<%# ── Mensajes flash (ej. "Orden creada" tras /lotes/nuevo) ─────────── %>
<% if (typeof flashOk !== 'undefined' && flashOk && flashOk.length) { %>
  <div class="flash flash--ok" role="status">
    <span class="flash__icon">✓</span>
    <span class="flash__text"><%= flashOk[0] %></span>
  </div>
<% } %>
<% if (typeof flashError !== 'undefined' && flashError && flashError.length) { %>
  <div class="flash flash--err" role="alert">
    <span class="flash__icon">⚠</span>
    <span class="flash__text"><%= flashError[0] %></span>
  </div>
<% } %>

<style>
  /* Banner flash que aparece arriba del panel después de un POST exitoso/erróneo */
  .flash {
    margin: 10px 16px 0;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 0.5px solid transparent;
  }
  .flash__icon {
    width: 20px; height: 20px;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 600; flex-shrink: 0;
  }
  .flash--ok {
    background: rgba(93, 202, 165, 0.12);
    border-color: var(--green-mid);
    color: var(--green-dark);
  }
  .flash--ok .flash__icon  { background: var(--green-dark); color: #fff; }
  .flash--err {
    background: rgba(226, 75, 74, 0.06);
    border-color: rgba(226, 75, 74, 0.4);
    color: #C42E2D;
  }
  .flash--err .flash__icon { background: #C42E2D; color: #fff; }
</style>

<!-- ── Topbar ──────────────────────────────────────────────────────── -->
<header class="topbar">
  <div class="topbar__left">
    <nav class="breadcrumb">
      <span class="breadcrumb__link">Inicio</span>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">Panel de lotes activos</span>
    </nav>
  </div>

  <div class="topbar__right">
    <a href="/lotes/nuevo" class="btn btn--primary">+ Nuevo lote</a>
    <div class="topbar__date"><%= fechaHoy %></div>
    <div class="avatar topbar__avatar"><%= usuario.iniciales %></div>
  </div>
</header>

<!-- ── Cuerpo principal ────────────────────────────────────────────── -->
<div class="panel-layout">

  <!-- ── Columna izquierda ──────────────────────────────────────── -->
  <div class="panel-main">

    <!-- KPI cards -->
    <div class="kpi-row">
      <div class="kpi-card">
        <span class="kpi-card__label">Lotes activos hoy</span>
        <span class="kpi-card__value"><%= stats.totalActivos %></span>
        <span class="kpi-card__delta kpi-card__delta--up">↑ <%= stats.deltaVsAyer %> vs ayer</span>
      </div>
      <div class="kpi-card kpi-card--warning">
        <span class="kpi-card__label">Pendientes de liberar</span>
        <div class="kpi-card__row">
          <span class="kpi-card__value kpi-card__value--warning"><%= stats.pendientesFirma %></span>
          <span class="kpi-card__tag">requieren firma</span>
        </div>
      </div>
      <div class="kpi-card kpi-card--alert">
        <span class="kpi-card__label">Alertas activas</span>
        <div class="kpi-card__row">
          <span class="kpi-card__value kpi-card__value--alert"><%= stats.alertasBPM %></span>
          <span class="kpi-card__tag">desviaciones BPM</span>
        </div>
      </div>
      <div class="kpi-card kpi-card--success">
        <span class="kpi-card__label">Tasa de cumplimiento</span>
        <span class="kpi-card__value kpi-card__value--success"><%= stats.tasaBPM %>%</span>
        <span class="kpi-card__delta">BPM este mes</span>
      </div>
    </div>

    <!-- Filtros y búsqueda -->
    <div class="panel-toolbar">
      <div class="search-box">
        <input
          type="text"
          class="search-box__input"
          placeholder="Buscar lote, producto..."
          id="buscarLote"
          oninput="aplicarFiltros()"
        />
      </div>
      <div class="filter-tabs" id="filterTabs">
        <button class="filter-tab filter-tab--active" data-filter="todos" data-count="<%= tabCounts.todos %>" onclick="setFiltro(this, 'todos')">
          Todos <span class="filter-tab__badge"><%= tabCounts.todos %></span>
        </button>
        <button class="filter-tab" data-filter="en_produccion" data-count="<%= tabCounts.en_produccion %>" onclick="setFiltro(this, 'en_produccion')">
          En producción <% if (tabCounts.en_produccion > 0) { %><span class="filter-tab__badge"><%= tabCounts.en_produccion %></span><% } %>
        </button>
        <button class="filter-tab" data-filter="en_calidad" data-count="<%= tabCounts.en_calidad %>" onclick="setFiltro(this, 'en_calidad')">
          En calidad <% if (tabCounts.en_calidad > 0) { %><span class="filter-tab__badge"><%= tabCounts.en_calidad %></span><% } %>
        </button>
        <button class="filter-tab" data-filter="pendiente_firma" data-count="<%= tabCounts.pendiente_firma %>" onclick="setFiltro(this, 'pendiente_firma')">
          Pendiente lib. <% if (tabCounts.pendiente_firma > 0) { %><span class="filter-tab__badge filter-tab__badge--warning"><%= tabCounts.pendiente_firma %></span><% } %>
        </button>
        <button class="filter-tab" data-filter="liberado" data-count="<%= tabCounts.liberado %>" onclick="setFiltro(this, 'liberado')">
          Liberados <% if (tabCounts.liberado > 0) { %><span class="filter-tab__badge filter-tab__badge--success"><%= tabCounts.liberado %></span><% } %>
        </button>
      </div>

    </div>

    <!-- Lista de lotes -->
    <section class="lotes-section">
      <div class="lotes-section__header">
        <h2 class="lotes-section__title" id="lotesSectionTitle">Lotes en curso</h2>
        <span class="lotes-section__meta" id="lotesCount"><%= lotes.length %> lotes · actualizado hace 2 min</span>
      </div>

      <div class="lotes-list" id="lotesLista">
        <% lotes.forEach(function(lote) { %>
          <%
            // ID legible para mostrar (ej. "FT-2026-0041") y URL al stepper
            // (LoteController.getPaso espera parseInt(req.params.id) ⇒ usamos lote.id).
            var displayId = lote.numeroLote || lote.id;
          %>
          <div class="lote-card lote-card--<%= lote.estado %>" data-estado="<%= lote.estado %>" data-nombre="<%= lote.producto.toLowerCase() %>" data-id="<%= String(displayId).toLowerCase() %>">

            <!-- Cabecera de la card -->
            <div class="lote-card__header">
              <div class="lote-card__info">
                <span class="lote-card__id"><%= displayId %></span>
                <h3 class="lote-card__nombre"><%= lote.producto %></h3>
              </div>
              <span class="badge badge--<%= lote.estado %>">
                <% if (lote.estado === 'alerta_bpm') { %>⚠ <% } %>
                <%= lote.estadoLabel %>
              </span>
            </div>

            <!-- Progreso del stepper -->
            <div class="lote-card__progress">
              <% for (let i = 1; i <= 9; i++) { %>
                <div class="progress-step progress-step--<%= i < lote.pasoActual ? 'done' : (i === lote.pasoActual ? 'active' : 'pending') %>"></div>
              <% } %>
            </div>

            <!-- Meta info -->
            <div class="lote-card__meta">
              <div class="lote-card__operario">
                <div class="avatar avatar--sm"><%= lote.operarioIniciales %></div>
                <span class="lote-card__operario-nombre"><%= lote.operario %></span>
                <span class="lote-card__paso">Paso <%= lote.pasoActual %>/9</span>
                <span class="lote-card__tiempo"><%= lote.tiempoTranscurrido %></span>
              </div>
              <% if (lote.estado === 'alerta_bpm') { %>
                <span class="lote-card__alerta-label">⚠ Desviación BPM detectada · Paso <%= lote.pasoActual %>/9</span>
              <% } %>
            </div>

            <!-- Acciones -->
            <div class="lote-card__actions">
              <% if (lote.estado === 'en_produccion') { %>
                <%# RQF-06: el botón "Continuar lote" abre el stepper en el paso donde va el lote %>
                <a href="/lotes/<%= lote.id %>/paso/<%= lote.pasoActual %>" class="btn btn--primary btn--sm">Continuar lote</a>
              <% } else if (lote.estado === 'pendiente_firma') { %>
                <a href="/lotes/<%= lote.id %>/paso/<%= lote.pasoActual %>" class="btn btn--primary btn--sm">Revisar lote</a>
              <% } else if (lote.estado === 'en_calidad') { %>
                <a href="/lotes/<%= lote.id %>/paso/<%= lote.pasoActual %>" class="btn btn--secondary btn--sm">Ver resultados</a>
              <% } else if (lote.estado === 'alerta_bpm') { %>
                <a href="/lotes/<%= lote.id %>/paso/<%= lote.pasoActual %>" class="btn btn--alert btn--sm">Ver alerta</a>
              <% } else { %>
                <a href="/lotes/<%= lote.id %>" class="btn btn--secondary btn--sm">Ver detalle</a>
              <% } %>
              <a href="/lotes/<%= lote.id %>" class="btn btn--ghost btn--sm">Más detalles</a>
            </div>

          </div>
        <% }); %>
      </div>

      <% if (lotes.length > 4) { %>
        <button class="ver-todos-btn" onclick="verTodos()">
          + <%= lotes.length - 4 %> lotes adicionales · Ver todos →
        </button>
      <% } %>
    </section>

  </div><!-- /panel-main -->

  <!-- ── Columna derecha ────────────────────────────────────────── -->
  <aside class="panel-aside">

    <!-- Resumen del día -->
    <div class="aside-card">
      <h3 class="aside-card__title">Resumen del día</h3>
      <ul class="resumen-list">
        <li class="resumen-item">
          <span class="resumen-item__label">Lotes iniciados hoy</span>
          <span class="resumen-item__value"><%= resumen.lotesIniciados %></span>
        </li>
        <li class="resumen-item">
          <span class="resumen-item__label">Lotes pendientes de firma</span>
          <span class="resumen-item__value resumen-item__value--warning"><%= resumen.pendientesFirma %></span>
        </li>
        <li class="resumen-item">
          <span class="resumen-item__label">Alertas BPM activas</span>
          <span class="resumen-item__value resumen-item__value--alert"><%= resumen.alertasBPM %></span>
        </li>
        <li class="resumen-item">
          <span class="resumen-item__label">Lotes liberados este mes</span>
          <span class="resumen-item__value"><%= resumen.liberadosMes %></span>
        </li>
        <li class="resumen-item resumen-item--divider">
          <span class="resumen-item__label">Tasa BPM mensual</span>
          <span class="resumen-item__value resumen-item__value--success"><%= resumen.tasaBPM %>% ✓</span>
        </li>
      </ul>
      <a href="/reportes" class="aside-link">Ver reporte completo →</a>
    </div>

    <!-- Pendiente de tu atención -->
    <div class="aside-card">
      <h3 class="aside-card__title">Pendiente de tu atención</h3>
      <ul class="atencion-list">
        <% pendientes.forEach(function(p) { %>
          <li class="atencion-item atencion-item--<%= p.tipo %>">
            <div class="atencion-item__body">
              <span class="atencion-item__label"><%= p.label %></span>
              <span class="atencion-item__lote"><%= p.loteId %> · <%= p.producto %></span>
            </div>
            <a href="<%= p.href %>" class="atencion-item__accion"><%= p.accion %> →</a>
          </li>
        <% }); %>
      </ul>
    </div>

    <!-- Bitácora reciente -->
    <div class="aside-card">
      <h3 class="aside-card__title">Bitácora reciente</h3>
      <ul class="bitacora-list">
        <% bitacora.forEach(function(ev) { %>
          <li class="bitacora-item">
            <span class="bitacora-item__dot bitacora-item__dot--<%= ev.tipo %>"></span>
            <div class="bitacora-item__body">
              <span class="bitacora-item__texto"><%= ev.texto %></span>
              <span class="bitacora-item__meta"><%= ev.tiempo %> · <%= ev.usuario %></span>
            </div>
          </li>
        <% }); %>
      </ul>
      <a href="/bitacora" class="aside-link">Ver bitácora completa →</a>
    </div>

  </aside><!-- /panel-aside -->

</div><!-- /panel-layout -->

<!-- ── Script de filtrado y búsqueda (RQF-07) ─────────────────────── -->
<script>
  // ─────────────────────────────────────────────────────────────────
  //  Estado global del módulo
  // ─────────────────────────────────────────────────────────────────
  let filtroActivo = 'todos';

  // Algunos estados internos no tienen tab propio; los mapeamos al tab
  // más cercano para que aparezcan cuando ese tab esté activo.
  const FILTRO_MAP = {
    en_produccion:   'en_produccion',
    alerta_bpm:      'en_produccion',
    en_espera:       'en_produccion',
    en_calidad:      'en_calidad',
    bloqueado:       'en_calidad',
    pendiente_firma: 'pendiente_firma',
    liberado:        'liberado',
    rechazado:       'liberado',
  };

  // ─────────────────────────────────────────────────────────────────
  //  Función central: aplica filtro activo + texto del buscador
  // ─────────────────────────────────────────────────────────────────
  function aplicarFiltros() {
    const q     = (document.getElementById('buscarLote').value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('#lotesLista .lote-card');

    cards.forEach(card => {
      const estado = card.dataset.estado || '';
      const nombre = card.dataset.nombre || '';
      const id     = card.dataset.id     || '';

      const coincideTexto  = !q || nombre.includes(q) || id.includes(q);
      const coincideFiltro = filtroActivo === 'todos'
        ? true
        : estado === filtroActivo || FILTRO_MAP[estado] === filtroActivo;

      card.style.display = (coincideTexto && coincideFiltro) ? '' : 'none';
    });

    actualizarUI();
  }

  // ─────────────────────────────────────────────────────────────────
  //  Cambiar tab activo
  // ─────────────────────────────────────────────────────────────────
  function setFiltro(btn, filtro) {
    filtroActivo = filtro;
    document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('filter-tab--active'));
    btn.classList.add('filter-tab--active');
    aplicarFiltros();
  }

  // ─────────────────────────────────────────────────────────────────
  //  Actualizar título, contador y estado vacío
  // ─────────────────────────────────────────────────────────────────
  function actualizarUI() {
    const lista    = document.getElementById('lotesLista');
    const visibles = [...lista.querySelectorAll('.lote-card')]
                       .filter(c => c.style.display !== 'none').length;

    // Título de la sección
    const tabActivo  = document.querySelector('.filter-tab--active');
    const labelTexto = tabActivo
      ? tabActivo.firstChild.textContent.trim()
      : 'Lotes en curso';
    document.getElementById('lotesSectionTitle').textContent =
      filtroActivo === 'todos' ? 'Lotes en curso' : labelTexto;

    // Contador de lotes
    document.getElementById('lotesCount').textContent =
      visibles + (visibles === 1 ? ' lote' : ' lotes') +
      (filtroActivo !== 'todos' ? ' en este estado' : '') +
      ' · actualizado hace 2 min';

    // Estado vacío
    const hayVacio = lista.querySelector('.lotes-vacio');
    if (visibles === 0 && !hayVacio) {
      const el = document.createElement('div');
      el.className = 'lotes-vacio';
      el.innerHTML =
        '<span class="lotes-vacio__icon">📋</span>' +
        '<p class="lotes-vacio__texto">No hay lotes en este estado.</p>';
      lista.appendChild(el);
    } else if (visibles > 0 && hayVacio) {
      hayVacio.remove();
    }
  }

  // ─────────────────────────────────────────────────────────────────
  //  Ver todos los ocultos por el límite de 4
  // ─────────────────────────────────────────────────────────────────
  function verTodos() {
    document.querySelectorAll('#lotesLista .lote-card').forEach(c => c.style.display = '');
    document.querySelector('.ver-todos-btn')?.remove();
    actualizarUI();
  }
</script>
