<%# Datos previamente guardados por el operario en este paso (si existen) %>
<%
  const _datos = (lote && lote.pasos && lote.pasos[paso]) || {};
  const D = (k, def = '') => (_datos[k] !== undefined && _datos[k] !== '') ? _datos[k] : def;
  const C = (k) => (_datos[k] === true || _datos[k] === 'on' || _datos[k] === '1') ? 'checked' : '';
  // Reutilizamos las materias de paso2 de la fórmula del producto.
  const _pesosFormula = (typeof formula !== 'undefined' && formula && formula.paso2 && formula.paso2.materias)
    ? formula.paso2.materias
    : [
        { nombre:'Materia prima 1', espNum:'', espUnidad:'', min:null, max:null },
        { nombre:'Materia prima 2', espNum:'', espUnidad:'', min:null, max:null },
      ];
%>
<%# views/operario/pasos/paso3.ejs — Verificación de pesos (editable) %>
<div class="step-page">
  <%- include('../partials/op-stepper-topbar') %>

  <form action="/mis-lotes/<%= lote.id %>/paso/<%= paso %>" method="POST" novalidate>
    <div class="step-layout">
      <div class="step-main">

        <div class="step-header">
          <div class="step-header__meta">
            <span>Paso 3/9 · <%= lote.numeroLote %> · <%= lote.producto %> · Operario: <%= operario.nombre %></span>
            <span class="step-header__badge" style="background:rgba(93,202,165,0.16); border-color:var(--green-mid); color:var(--green-dark);">✎ Editable · Operario</span>
            <span class="step-header__timer">⏱ <%= tiempoTranscurrido %></span>
          </div>
          <h1 class="step-header__title">Verificación de pesos</h1>
        </div>

        <% if (typeof flashError !== 'undefined' && flashError && flashError.length) { %>
          <div class="step-card" style="border-left:3px solid #E24B4A; background:rgba(226,75,74,0.05);">
            <p class="step-card__title" style="color:#C42E2D;">⚠ Peso fuera de rango BPM</p>
            <% flashError.forEach(function(e) { %><p style="font-size:11px; color:#C42E2D; line-height:1.5;"><%= e %></p><% }) %>
          </div>
        <% } %>

        <div class="step-card">
          <p class="step-card__title">Registro de pesos — <%= lote.producto %> (paso crítico)</p>
          <div class="info-notice" style="margin-bottom:10px">
            ⚠ Si algún peso sale fuera del rango BPM, el sistema bloquea el guardado y debe abrirse una No Conformidad.
          </div>
          <table class="step-table">
            <thead>
              <tr>
                <th>Materia prima</th>
                <th>Teórico</th>
                <th>Mín</th>
                <th>Máx</th>
                <th>Peso registrado</th>
              </tr>
            </thead>
            <tbody>
              <% _pesosFormula.forEach(function(m, i) { %>
                <% const _prev = (_datos.pesos && _datos.pesos[i]) || {}; %>
                <tr>
                  <td><%= m.nombre %></td>
                  <td><%= m.espNum %> <%= m.espUnidad %></td>
                  <td><%= m.min !== null && m.min !== undefined ? m.min : '—' %></td>
                  <td><%= m.max !== null && m.max !== undefined ? m.max : '—' %></td>
                  <td>
                    <input type="number" step="0.1" name="peso_<%= i %>"
                           placeholder="<%= m.espNum %>"
                           value="<%= _prev.registrado || '' %>">
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="step-card">
          <p class="step-card__title">Confirmaciones del paso</p>
          <div class="checklist-grid">
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_balanza" value="1" <%= C('chk_balanza') %>><span>Balanza calibrada</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_pesos_reg" value="1" <%= C('chk_pesos_reg') %>><span>Pesos registrados</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_bpm" value="1" <%= C('chk_bpm') %>><span>Dentro de BPM</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_area_limpia" value="1" <%= C('chk_area_limpia') %>><span>Área limpia</span></label>
          </div>
        </div>

        <div class="step-card">
          <label class="step-card__title" for="observaciones">Observaciones del paso</label>
          <textarea name="observaciones" id="observaciones" class="field-value field-value--wide"
                    rows="3" placeholder="Reporta desviaciones, ajustes o no conformidades..."><%= D('observaciones') %></textarea>
        </div>

      </div>

      <%- include('../partials/op-stepper-aside') %>
    </div>

    <div class="step-footer">
      <div class="step-footer__left">
        <span>✎ Editando paso <%= paso %>/9 · <%= operario.nombre %></span>
      </div>
      <div class="step-footer__right">
        <button type="submit" name="accion" value="anterior" formnovalidate class="btn-step btn-step--secondary">← Paso anterior</button>
        <button type="submit" class="btn-step"
                style="background:var(--green-dark); color:#fff; border-color:var(--green-dark); cursor:pointer;">
          Guardar y continuar →
        </button>
      </div>
    </div>
  </form>
</div>
