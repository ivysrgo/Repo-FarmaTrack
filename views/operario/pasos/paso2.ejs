<%# Datos previamente guardados por el operario en este paso (si existen) %>
<%
  const _datos = (lote && lote.pasos && lote.pasos[paso]) || {};
  const D = (k, def = '') => (_datos[k] !== undefined && _datos[k] !== '') ? _datos[k] : def;
  const C = (k) => (_datos[k] === true || _datos[k] === 'on' || _datos[k] === '1') ? 'checked' : '';
  // Materias primas: de la fórmula del producto. Si no hay fórmula, usamos
  // un set genérico (legacy) para que la vista no se rompa.
  const _materiasFormula = (typeof formula !== 'undefined' && formula && formula.paso2 && formula.paso2.materias)
    ? formula.paso2.materias
    : [
        { nombre:'Materia prima 1', espNum:'',      espUnidad:'', min:null, max:null },
        { nombre:'Materia prima 2', espNum:'',      espUnidad:'', min:null, max:null },
        { nombre:'Materia prima 3', espNum:'',      espUnidad:'', min:null, max:null },
      ];
%>
<%# views/operario/pasos/paso2.ejs — Traslado de materias primas (editable) %>
<div class="step-page">
  <%- include('../partials/op-stepper-topbar') %>

  <form action="/mis-lotes/<%= lote.id %>/paso/<%= paso %>" method="POST" novalidate>
    <div class="step-layout">
      <div class="step-main">

        <div class="step-header">
          <div class="step-header__meta">
            <span>Paso 2/9 · <%= lote.numeroLote %> · <%= lote.producto %> · Operario: <%= operario.nombre %></span>
            <span class="step-header__badge" style="background:rgba(93,202,165,0.16); border-color:var(--green-mid); color:var(--green-dark);">✎ Editable · Operario</span>
            <span class="step-header__timer">⏱ <%= tiempoTranscurrido %></span>
          </div>
          <h1 class="step-header__title">Traslado de materias primas</h1>
        </div>

        <% if (typeof flashError !== 'undefined' && flashError && flashError.length) { %>
          <div class="step-card" style="border-left:3px solid #E24B4A; background:rgba(226,75,74,0.05);">
            <p class="step-card__title" style="color:#C42E2D;">⚠ Valor fuera de rango BPM</p>
            <% flashError.forEach(function(e) { %><p style="font-size:11px; color:#C42E2D; line-height:1.5;"><%= e %></p><% }) %>
          </div>
        <% } %>

        <!-- Tabla editable de materias primas (de la fórmula del producto) -->
        <div class="step-card">
          <p class="step-card__title">Recepción de materias primas — <%= lote.producto %></p>
          <% if (typeof formula === 'undefined' || !formula) { %>
            <p style="font-size:11px; color:var(--muted); margin-bottom:8px;">
              ⓘ Este producto no tiene fórmula registrada — la tabla aparece sin rangos esperados.
            </p>
          <% } %>
          <table class="step-table">
            <thead>
              <tr>
                <th>Materia prima</th>
                <th>Cantidad esperada</th>
                <th>Rango BPM</th>
                <th>Cantidad recibida</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% _materiasFormula.forEach(function(m, i) { %>
                <% const _prev = (_datos.materias && _datos.materias[i]) || {}; %>
                <tr>
                  <td><%= m.nombre %></td>
                  <td><%= m.espNum %> <%= m.espUnidad %></td>
                  <td style="font-size:11px; color:var(--muted);">
                    <% if (m.min !== null && m.min !== undefined) { %>
                      <%= m.min %>–<%= m.max %> <%= m.espUnidad %>
                    <% } else { %>—<% } %>
                  </td>
                  <td>
                    <input type="number" step="0.1" name="mp_<%= i %>_recibida"
                           placeholder="<%= m.espNum %>"
                           value="<%= _prev.recibida || '' %>">
                  </td>
                  <td>
                    <select name="mp_<%= i %>_estado">
                      <option value="conforme"     <%= _prev.estado === 'conforme' ? 'selected' : '' %>>Conforme</option>
                      <option value="no_conforme"  <%= _prev.estado === 'no_conforme' ? 'selected' : '' %>>No conforme</option>
                    </select>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="step-card">
          <p class="step-card__title">Confirmaciones del paso</p>
          <div class="checklist-grid">
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_mp_laboratorio" value="1"><span>Todas las MP están en laboratorio</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_transporte" value="1"><span>Condiciones de transporte OK</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_embalajes" value="1"><span>Embalajes sin daños</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_temperatura" value="1"><span>Temperatura verificada</span></label>
          </div>
        </div>

        <div class="step-card">
          <label class="step-card__title" for="observaciones">Observaciones del paso</label>
          <textarea name="observaciones" id="observaciones" class="field-value field-value--wide"
                    rows="3" placeholder="Estado de los embalajes, novedades de la cadena de frío..."><%= D('observaciones') %></textarea>
        </div>

      </div>

      <%- include('../partials/op-stepper-aside') %>
    </div>

    <div class="step-footer">
      <div class="step-footer__left">
        <span>✎ Editando paso <%= paso %>/9 · <%= operario.nombre %></span>
      </div>
      <div class="step-footer__right">
        <button type="submit" name="accion" value="anterior" formnovalidate class="btn-step btn-step--secondary">← Paso anterior</button>
        <button type="submit" class="btn-step"
                style="background:var(--green-dark); color:#fff; border-color:var(--green-dark); cursor:pointer;">
          Guardar y continuar →
        </button>
      </div>
    </div>
  </form>
</div>
