<%# Datos previamente guardados por el operario en este paso (si existen) %>
<%
  const _datos = (lote && lote.pasos && lote.pasos[paso]) || {};
  const D = (k, def = '') => (_datos[k] !== undefined && _datos[k] !== '') ? _datos[k] : def;
  const C = (k) => (_datos[k] === true || _datos[k] === 'on' || _datos[k] === '1') ? 'checked' : '';
  // Controles de calidad de la fórmula del producto.
  const _controlesFormula = (typeof formula !== 'undefined' && formula && formula.paso5 && formula.paso5.controles)
    ? formula.paso5.controles
    : [
        { nombre:'Control 1', min:null, max:null, unidad:'' },
        { nombre:'Control 2', min:null, max:null, unidad:'' },
      ];
%>
<%# views/operario/pasos/paso5.ejs — Controles de calidad (editable, paso crítico) %>
<div class="step-page">
  <%- include('../partials/op-stepper-topbar') %>

  <form action="/mis-lotes/<%= lote.id %>/paso/<%= paso %>" method="POST" novalidate>
    <div class="step-layout">
      <div class="step-main">

        <div class="step-header">
          <div class="step-header__meta">
            <span>Paso 5/9 · <%= lote.numeroLote %> · <%= lote.producto %> · Operario: <%= operario.nombre %></span>
            <span class="step-header__badge" style="background:rgba(93,202,165,0.16); border-color:var(--green-mid); color:var(--green-dark);">✎ Editable · Operario</span>
            <span class="step-header__timer">⏱️ <%= tiempoTranscurrido %></span>
          </div>
          <h1 class="step-header__title">Controles de calidad</h1>
        </div>

        <% if (typeof flashError !== 'undefined' && flashError && flashError.length) { %>
          <div class="step-card" style="border-left:3px solid #E24B4A; background:rgba(226,75,74,0.05);">
            <p class="step-card__title" style="color:#C42E2D;">⚠️ Control fuera de rango BPM</p>
            <% flashError.forEach(function(e) { %><p style="font-size:11px; color:#C42E2D; line-height:1.5;"><%= e %></p><% }) %>
          </div>
        <% } %>

        <div class="step-card">
          <p class="step-card__title">Controles intermedios — <%= lote.producto %></p>
          <div class="info-notice" style="margin-bottom:10px">
            ⚠️ Paso crítico. Si algún valor cae fuera del rango, el sistema bloquea el guardado y debe abrirse una No Conformidad.
          </div>
          <table class="step-table">
            <thead>
              <tr>
                <th>Parámetro</th>
                <th>Mín</th>
                <th>Máx</th>
                <th>Unidad</th>
                <th>Valor obtenido</th>
              </tr>
            </thead>
            <tbody>
              <% _controlesFormula.forEach(function(c, i) { %>
                <% const _prev = (_datos.controles && _datos.controles[i]) || {}; %>
                <tr>
                  <td><%= c.nombre %></td>
                  <td><%= c.min !== null && c.min !== undefined ? c.min : '—' %></td>
                  <td><%= c.max !== null && c.max !== undefined ? c.max : '—' %></td>
                  <td><%= c.unidad || '—' %></td>
                  <td>
                    <input type="number" step="0.01" name="control_<%= i %>_valor"
                           placeholder="Valor medido"
                           value="<%= _prev.valor || '' %>">
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="step-card">
          <p class="step-card__title">Confirmaciones del paso</p>
          <div class="checklist-grid">
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_controles" value="1" <%= C('chk_controles') %>><span>Controles ejecutados</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_lab" value="1" <%= C('chk_lab') %>><span>Reporte de laboratorio adjunto</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_dentro_espec" value="1" <%= C('chk_dentro_espec') %>><span>Resultados dentro de especificación</span></label>
            <label class="check-row" style="cursor:pointer;"><input type="checkbox" name="chk_desviaciones" value="1" <%= C('chk_desviaciones') %>><span>Desviaciones revisadas</span></label>
          </div>
        </div>

        <div class="step-card">
          <label class="step-card__title" for="observaciones">Observaciones del paso</label>
          <textarea name="observaciones" id="observaciones" class="field-value field-value--wide"
                    rows="3" placeholder="Reporta ajustes, repeticiones de medición, NC abiertas..."><%= D('observaciones') %></textarea>
        </div>

      </div>

      <%- include('../partials/op-stepper-aside') %>
    </div>

    <div class="step-footer">
      <div class="step-footer__left">
        <span>✎ Editando paso <%= paso %>/9 · <%= operario.nombre %></span>
      </div>
      <div class="step-footer__right">
        <button type="submit" name="accion" value="anterior" formnovalidate class="btn-step btn-step--secondary">← Paso anterior</button>
        <button type="submit" class="btn-step"
                style="background:var(--green-dark); color:#fff; border-color:var(--green-dark); cursor:pointer;">
          Guardar y continuar →
        </button>
      </div>
    </div>
  </form>
</div>