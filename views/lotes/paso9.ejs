<%# views/lotes/paso9.ejs — Etiquetado %>
<div class="step-page">
  <%- include('../partials/stepper-topbar') %>

  <div class="step-layout">
    <div class="step-main">

      <div class="step-header">
        <div class="step-header__meta">
          <span>Paso 9/9 · <%= lote.numeroLote %> · <%= lote.producto || lote.medicamento || '—' %> · Operario: <%= operario.nombre %></span>
          <span class="step-header__badge" style="background:rgba(26,92,58,0.12); border-color:var(--green-dark); color:var(--green-dark);">✅ Lote completado</span>
          <span class="step-header__timer">⏱ <%= tiempoTranscurrido %></span>
        </div>
        <h1 class="step-header__title">Etiquetado</h1>
      </div>

      <div class="readonly-notice">🔒 Vista de solo lectura — Director Técnico. Este paso fue completado por el Operario.</div>

      <!-- Verificación de etiquetas -->
      <div class="step-card">
        <p class="step-card__title">Verificación de etiquetado — completado por operario</p>
        <% if (lote.estado === 'liberado') { %>
          <div class="info-notice" style="margin-bottom:14px; background:rgba(26,92,58,0.10); border-color:var(--green-dark); color:var(--green-dark);">
            ✓ Lote liberado<% if (lote.liberadoPor) { %> por <%= lote.liberadoPor %><% } %>.
            <% if (lote.liberadoEn) { %>
              Firma registrada el <%= new Date(lote.liberadoEn).toLocaleString('es-CO', { dateStyle:'long', timeStyle:'short' }) %>.
            <% } %>
          </div>
        <% } else { %>
          <div class="info-notice" style="margin-bottom:14px">
            ✅ Todas las verificaciones de etiquetado fueron confirmadas por el operario. Lote listo para liberación.
          </div>
        <% } %>

        <div class="checklist-grid">
          <% checklist.forEach(item => { %>
            <div class="check-row<%= item.checked ? ' is-checked' : '' %>">
              <div class="check-box"><%= item.checked ? '✓' : '' %></div>
              <span><%= item.texto %></span>
            </div>
          <% }) %>
        </div>

        <div style="margin-top:16px">
          <div class="field-group">
            <span class="field-label">Cantidad de unidades etiquetadas</span>
            <div class="field-value" style="max-width:200px;"><%= unidadesEtiquetadas %> unidades</div>
          </div>
        </div>

        <div style="margin-top:12px">
          <p class="obs-label">Observaciones del operario</p>
          <div class="field-value field-value--wide"><%= observaciones %></div>
        </div>
      </div>

      <!-- Resumen del lote completado -->
      <div class="step-card" style="border-color: var(--green-mid); background: rgba(93,202,165,0.04);">
        <p class="step-card__title" style="color:var(--green-dark);">🏭 Resumen del lote — <%= lote.numeroLote %></p>
        <div class="field-grid field-grid--3" style="margin-top:8px;">
          <div class="field-group">
            <span class="field-label">Medicamento</span>
            <div class="field-value" style="background:var(--white)"><%= lote.producto || lote.medicamento || '—' %></div>
          </div>
          <div class="field-group">
            <span class="field-label">Cantidad planificada</span>
            <div class="field-value" style="background:var(--white)"><%= lote.cantidadPlanificada.toLocaleString('es-CO') %> unidades</div>
          </div>
          <div class="field-group">
            <span class="field-label">Unidades etiquetadas</span>
            <div class="field-value" style="background:var(--white)"><%= unidadesEtiquetadas %> unidades</div>
          </div>
          <div class="field-group">
            <span class="field-label">Operario</span>
            <div class="field-value" style="background:var(--white)"><%= lote.operario %></div>
          </div>
          <div class="field-group">
            <span class="field-label">Estado final</span>
            <% if (lote.estado === 'liberado') { %>
              <div class="field-value" style="background:var(--white); color:var(--green-dark); font-weight:500;">✓ Liberado</div>
            <% } else if (lote.estado === 'rechazado') { %>
              <div class="field-value" style="background:var(--white); color:#C42E2D; font-weight:500;">✗ Rechazado</div>
            <% } else { %>
              <div class="field-value" style="background:var(--white); color:var(--green-dark); font-weight:500;">✅ Listo para liberar</div>
            <% } %>
          </div>
          <div class="field-group">
            <span class="field-label">Pasos completados</span>
            <div class="field-value" style="background:var(--white);">9 / 9</div>
          </div>
        </div>
      </div>

      <div class="step-card">
        <p class="obs-label">Observaciones del operario (solo lectura)</p>
        <div class="field-value field-value--wide" style="color:var(--muted)">Sin observaciones adicionales registradas en este paso.</div>
      </div>

    </div>

    <!-- Aside final -->
    <aside class="step-aside">
      <div class="aside-card">
        <p class="aside-card__title">Checklist paso 9 — Operario</p>
        <div class="aside-checklist">
          <% checklist.forEach(item => { %>
            <div class="aside-check-item<%= item.checked ? ' is-checked' : '' %>">
              <div class="check-dot"><%= item.checked ? '✓' : '' %></div>
              <span><%= item.texto %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <% if (lote.estado === 'liberado') { %>
        <div class="aside-card" style="border-color:var(--green-dark); background:rgba(26,92,58,0.05);">
          <p class="aside-card__title" style="color:var(--green-dark);">✓ Lote liberado</p>
          <p style="font-size:11px; color:var(--muted); margin-top:4px;">
            Firmado<% if (lote.liberadoPor) { %> por <%= lote.liberadoPor %><% } %>.
            <% if (lote.liberadoEn) { %>
              <br/><%= new Date(lote.liberadoEn).toLocaleString('es-CO', { dateStyle:'short', timeStyle:'short' }) %>
            <% } %>
          </p>
        </div>
      <% } else { %>
        <div class="aside-card" style="border-color:var(--green-mid);">
          <p class="aside-card__title" style="color:var(--green-dark);">✅ Lote completado</p>
          <p style="font-size:11px; color:var(--muted); margin-top:4px;">
            Todos los pasos del proceso han sido completados y verificados.
            Pendiente la firma del Director Técnico.
          </p>
        </div>
      <% } %>

      <div class="aside-card">
        <p class="aside-card__title">Eventos recientes</p>
        <div class="event-list">
          <% eventos.forEach(ev => { %>
            <div class="event-item">
              <div class="event-dot"></div>
              <span class="event-item__text"><%= ev.texto %></span>
              <span class="event-item__time"><%= ev.hora %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="aside-card">
        <p class="aside-card__title">Navegación de pasos</p>
        <div class="nav-step-list">
          <% pasos.forEach(p => { %>
            <a href="/lotes/<%= lote.id %>/paso/<%= p.n %>"
               class="nav-step-item nav-step-item--done">
              <div class="nav-step-dot nav-step-dot--done"></div>
              <span>Paso <%= p.n %> — <%= p.nombre %> ✓</span>
            </a>
          <% }) %>
        </div>
      </div>
    </aside>
  </div>

  <%# ─── Footer del paso 9 ──────────────────────────────────────────
       Caso A) lote ya liberado     → badge informativo (no se puede re-liberar)
       Caso B) lote rechazado       → mensaje en rojo, no se libera
       Caso C) cualquier otro estado→ formulario POST /lotes/:id/liberar
       El botón principal está dentro de un <form> para que pueda hacer POST.
  %>
  <div class="step-footer">
    <div class="step-footer__left">
      <% if (lote.estado === 'liberado') { %>
        <span style="color:var(--green-dark); font-weight:500;">
          ✓ Liberado<% if (lote.liberadoPor) { %> por <%= lote.liberadoPor %><% } %>
          <% if (lote.liberadoEn) { %>
            · <%= new Date(lote.liberadoEn).toLocaleString('es-CO', { dateStyle:'short', timeStyle:'short' }) %>
          <% } %>
        </span>
      <% } else if (lote.estado === 'rechazado') { %>
        <span style="color:#C42E2D; font-weight:500;">✗ Lote rechazado — no puede liberarse</span>
      <% } else { %>
        <span>Listo para firma y liberación</span>
      <% } %>
    </div>

    <div class="step-footer__right">
      <a href="/lotes/<%= lote.id %>/paso/8" class="btn-step btn-step--secondary">← Paso anterior</a>

      <% if (lote.estado === 'liberado' || lote.estado === 'rechazado') { %>
        <%# Acción terminal ya hecha — solo mostramos vuelta al dashboard %>
        <a href="<%= typeof dashboardPath !== 'undefined' ? dashboardPath : '/panel' %>" class="btn-step btn-step--secondary">
          Volver a <%= typeof dashboardLabel !== 'undefined' ? dashboardLabel.toLowerCase() : 'panel' %>
        </a>
      <% } else { %>
        <%# Acción principal: liberar el lote — abre modal de confirmación.
             El POST real lo hace el form que está dentro del modal. %>
        <button type="button"
                class="btn-step"
                style="background:var(--green-dark); color:#fff; border-color:var(--green-dark); cursor:pointer;"
                onclick="document.getElementById('liberarModal').classList.add('is-open')">
          ✓ Liberar lote y firmar →
        </button>
      <% } %>
    </div>
  </div>

  <%# ─── Modal de confirmación de liberación ─────────────────────────
       Solo se renderiza si el lote NO está ya liberado/rechazado. Se
       abre vía clic en el botón principal y se cierra con Cancelar o
       clic fuera del card. Usa los tokens del design system. %>
  <% if (lote.estado !== 'liberado' && lote.estado !== 'rechazado') { %>
    <div id="liberarModal" class="ft-modal" role="dialog" aria-modal="true" aria-labelledby="liberarModalTitle"
         onclick="if (event.target === this) this.classList.remove('is-open')">
      <div class="ft-modal__card">
        <header class="ft-modal__head">
          <span class="ft-modal__icon">✓</span>
          <div>
            <h2 id="liberarModalTitle" class="ft-modal__title">Liberar lote</h2>
            <p class="ft-modal__sub">Lote <strong><%= lote.numeroLote %></strong> · <%= lote.producto %></p>
          </div>
        </header>

        <div class="ft-modal__body">
          <p>Estás a punto de firmar y liberar este lote como <strong>Director Técnico</strong>.</p>
          <ul class="ft-modal__lista">
            <li>Tu firma queda registrada en el batch record.</li>
            <li>El lote se marca como <strong>liberado</strong> en el sistema.</li>
            <li>La acción se registra en la bitácora PAYRMA y no puede deshacerse.</li>
          </ul>
        </div>

        <footer class="ft-modal__foot">
          <button type="button" class="ft-modal__btn ft-modal__btn--secondary"
                  onclick="document.getElementById('liberarModal').classList.remove('is-open')">
            Cancelar
          </button>
          <form action="/lotes/<%= lote.id %>/liberar" method="POST" style="margin:0;">
            <button type="submit" class="ft-modal__btn ft-modal__btn--primary">
              ✓ Confirmar y firmar
            </button>
          </form>
        </footer>
      </div>
    </div>
  <% } %>
</div>

<style>
  /* ── Modal de confirmación FarmaTrack ─────────────────────────── */
  .ft-modal {
    display: none;
    position: fixed; inset: 0;
    background: rgba(20, 30, 28, 0.45);
    z-index: 9999;
    align-items: center; justify-content: center;
    padding: 24px;
    backdrop-filter: blur(2px);
  }
  .ft-modal.is-open { display: flex; }
  .ft-modal__card {
    background: var(--white, #fff);
    border-radius: 12px;
    width: 100%;
    max-width: 460px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    font-family: var(--font, inherit);
    animation: ftModalIn 0.18s ease-out;
  }
  @keyframes ftModalIn {
    from { transform: translateY(8px); opacity: 0; }
    to   { transform: translateY(0);   opacity: 1; }
  }
  .ft-modal__head {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 20px 22px 14px;
    border-bottom: 0.5px solid var(--border, #e8e3d8);
  }
  .ft-modal__icon {
    width: 36px; height: 36px;
    background: var(--green-dark, #2f5e4f);
    color: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .ft-modal__title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 2px;
    color: var(--text, #1a1a1a);
  }
  .ft-modal__sub {
    font-size: 12px;
    color: var(--muted, #8a8a8a);
    margin: 0;
  }
  .ft-modal__body {
    padding: 16px 22px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text, #1a1a1a);
  }
  .ft-modal__body p { margin: 0 0 10px; }
  .ft-modal__lista {
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 12px;
    color: var(--muted, #8a8a8a);
  }
  .ft-modal__lista li { margin-bottom: 4px; }
  .ft-modal__foot {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    padding: 14px 22px 18px;
    border-top: 0.5px solid var(--border, #e8e3d8);
    background: var(--input-bg, #f6f4ee);
  }
  .ft-modal__btn {
    height: 36px;
    padding: 0 18px;
    border-radius: 8px;
    font-family: var(--font, inherit);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: 0.5px solid transparent;
    transition: opacity 0.15s, background 0.15s;
  }
  .ft-modal__btn--secondary {
    background: var(--white, #fff);
    color: var(--text, #1a1a1a);
    border-color: var(--border, #e8e3d8);
  }
  .ft-modal__btn--secondary:hover { background: var(--input-bg, #f6f4ee); }
  .ft-modal__btn--primary {
    background: var(--green-dark, #2f5e4f);
    color: #fff;
    border-color: var(--green-dark, #2f5e4f);
  }
  .ft-modal__btn--primary:hover { opacity: 0.92; }
</style>
