<%# views/lotes/nuevo.ejs — Crear nueva orden de producción (RQF-01)
     Layout y secciones alineadas al Frame 7 — Empezar orden de producción. %>

<!-- ── Topbar ────────────────────────────────────────────────── -->
<div class="step-topbar">
  <div class="step-topbar__breadcrumb">
    <a href="<%= typeof dashboardPath !== 'undefined' ? dashboardPath : '/panel' %>">
      <%= typeof dashboardLabel !== 'undefined' ? dashboardLabel : 'Panel de lotes' %>
    </a>
    <span>/</span>
    <span>Nueva orden</span>
    <span style="margin-left:8px; color:var(--text); font-weight:500;">· Empezar orden de producción</span>
  </div>
  <div class="step-topbar__right">
    <span><%= fechaHoy %></span>
    <div class="step-topbar__avatar"><%= usuario.iniciales %></div>
  </div>
</div>

<div class="nuevo-layout">

  <!-- ════════════ Columna izquierda — Formulario ════════════ -->
  <div class="nuevo-main">

    <h1 class="nuevo-titulo">Nueva orden de producción</h1>
    <p class="nuevo-subtitulo">Completa los campos para iniciar el ciclo de vida del lote en el sistema.</p>

    <% if (typeof errores !== 'undefined' && errores.length > 0) { %>
      <div class="nuevo-errores">
        <strong>Corrige los siguientes errores:</strong>
        <ul>
          <% errores.forEach(function(e){ %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <%
      // Helper para preservar valores en re-render
      function v(k, def) {
        if (typeof values === 'undefined' || values == null) return def || '';
        return (values[k] !== undefined && values[k] !== null) ? values[k] : (def || '');
      }
      function checked(k) {
        if (typeof values === 'undefined' || values == null) return '';
        return values[k] ? 'checked' : '';
      }
    %>

    <form action="/lotes/nuevo" method="POST" id="nuevoForm" novalidate>

      <!-- ① Datos generales del lote -->
      <section class="nuevo-seccion">
        <header class="nuevo-seccion__head">
          <span class="nuevo-seccion__num">1</span>
          <h2 class="nuevo-seccion__titulo">Datos generales del lote</h2>
        </header>
        <p class="nuevo-seccion__hint">Completa todos los campos para iniciar el ciclo de vida del lote en el sistema.</p>

        <div class="field-grid field-grid--2" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="numeroOrden">Número de orden de producción</label>
            <input class="field-value" type="text" id="numeroOrden" name="numeroOrden"
                   placeholder="Ej: OP-2026-001" value="<%= v('numeroOrden') %>" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="codigoLote">Código de lote asignado</label>
            <input class="field-value" type="text" id="codigoLote" name="codigoLote"
                   placeholder="Ej: LT-2026-090" value="<%= v('codigoLote') %>" required>
          </div>
        </div>

        <div class="field-grid" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="producto">Producto a fabricar</label>
            <%# Texto libre — el nombre comercial puede variar (ej. "Amoxident 500"
                aplicando la fórmula maestra de "Amoxicilina 500 mg"). %>
            <input class="field-value" type="text" id="producto" name="producto"
                   placeholder="Escribe el nombre del producto..."
                   value="<%= v('producto') %>" required>
          </div>
        </div>

        <div class="field-grid field-grid--3" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="cantidad">Cantidad planificada (unid.)</label>
            <input class="field-value" type="number" id="cantidad" name="cantidad"
                   placeholder="Ej: 5000" min="100" value="<%= v('cantidad') %>" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="formaFarmaceutica">Forma farmacéutica</label>
            <input class="field-value" type="text" id="formaFarmaceutica" name="formaFarmaceutica"
                   placeholder="Ej: Tabletas" value="<%= v('formaFarmaceutica') %>">
          </div>
          <div class="field-group">
            <label class="field-label" for="concentracion">Concentración</label>
            <input class="field-value" type="text" id="concentracion" name="concentracion"
                   placeholder="Ej: 500mg" value="<%= v('concentracion') %>">
          </div>
        </div>

        <div class="field-grid field-grid--2">
          <div class="field-group">
            <label class="field-label" for="fechaInicio">Fecha de inicio planificada</label>
            <input class="field-value" type="date" id="fechaInicio" name="fechaInicio"
                   value="<%= v('fechaInicio') %>" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="fechaFin">Fecha estimada de fin</label>
            <input class="field-value" type="date" id="fechaFin" name="fechaFin"
                   value="<%= v('fechaFin') %>">
          </div>
        </div>
      </section>

      <!-- ② Responsables asignados -->
      <section class="nuevo-seccion">
        <header class="nuevo-seccion__head">
          <span class="nuevo-seccion__num">2</span>
          <h2 class="nuevo-seccion__titulo">Responsables asignados</h2>
        </header>

        <div class="field-grid field-grid--2" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="directorTecnico">Director Técnico responsable</label>
            <input class="field-value" type="text" id="directorTecnico" name="directorTecnico"
                   value="<%= v('directorTecnico', usuario.nombre || 'Director Técnico') %>" readonly
                   style="background:var(--input-bg); color:var(--text);">
          </div>
          <div class="field-group">
            <label class="field-label" for="operario">Operario de producción</label>
            <select class="field-value" id="operario" name="operario" required>
              <option value="">Selecciona operario...</option>
              <% const _operarios = (typeof operariosLista !== 'undefined' && operariosLista && operariosLista.length) ? operariosLista : ['Carlos Rodríguez','Luisa Martínez','Andrés Gómez','María Torres','Felipe Díaz']; %>
              <% _operarios.forEach(function(op) { %>
                <option value="<%= op %>" <%= v('operario') === op ? 'selected' : '' %>><%= op %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="field-grid field-grid--2">
          <div class="field-group">
            <label class="field-label" for="jefeCalidad">Jefe de calidad asignado</label>
            <select class="field-value" id="jefeCalidad" name="jefeCalidad" required>
              <option value="">Selecciona jefe de calidad...</option>
              <% const _jefes = (typeof jefesCalidadLista !== 'undefined' && jefesCalidadLista && jefesCalidadLista.length) ? jefesCalidadLista : ['Patricia Henao','Roberto Vega','Sofía Restrepo']; %>
              <% _jefes.forEach(function(jc) { %>
                <option value="<%= jc %>" <%= v('jefeCalidad') === jc ? 'selected' : '' %>><%= jc %></option>
              <% }); %>
            </select>
          </div>
          <div class="field-group">
            <label class="field-label" for="area">Área de producción</label>
            <select class="field-value" id="area" name="area" required>
              <option value="">Selecciona área...</option>
              <% ['Sólidos — Línea 1','Sólidos — Línea 2','Líquidos — Línea 1','Semisólidos — Línea 1'].forEach(function(a) { %>
                <option value="<%= a %>" <%= v('area') === a ? 'selected' : '' %>><%= a %></option>
              <% }); %>
            </select>
          </div>
        </div>
      </section>

      <!-- ③ Fórmula maestra -->
      <section class="nuevo-seccion">
        <header class="nuevo-seccion__head">
          <span class="nuevo-seccion__num">3</span>
          <h2 class="nuevo-seccion__titulo">Fórmula maestra</h2>
        </header>
        <p class="nuevo-seccion__hint">
          Elige una de las fórmulas maestras registradas. Sus MPs y rangos BPM
          son los que el operario debe respetar en cada paso del stepper.
        </p>

        <div class="field-grid" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="formulaId">Fórmula maestra a aplicar</label>
            <select class="field-value" id="formulaId" name="formulaId" required>
              <option value="">Selecciona la fórmula maestra registrada...</option>
              <% (typeof productosConFormula !== 'undefined' ? productosConFormula : []).forEach(function(f) { %>
                <option value="<%= f %>" <%= v('formulaId') === f ? 'selected' : '' %>><%= f %></option>
              <% }); %>
            </select>
            <small style="font-size:10px; color:var(--muted); margin-top:4px; display:block;">
              Solo se pueden iniciar lotes con una fórmula maestra ya registrada en el sistema.
            </small>
          </div>
        </div>

        <div id="formula-empty" class="formula-empty">
          <span style="color:var(--muted); font-size:12px;">Selecciona una fórmula arriba para ver las materias primas y rangos correspondientes.</span>
        </div>

        <div id="formula-content" class="formula-tabla-wrap" style="display:none;">
          <table class="step-table">
            <thead>
              <tr>
                <th>Materia prima</th>
                <th>Cantidad</th>
                <th>Unidad</th>
                <th>Rango BPM</th>
                <th>Estado stock</th>
              </tr>
            </thead>
            <tbody id="formula-mp-body">
              <!-- filas inyectadas por JS según producto -->
            </tbody>
          </table>
        </div>

        <div class="field-group" style="margin-top:var(--sp4);">
          <label class="field-label" for="observaciones">Observaciones del paso</label>
          <textarea class="field-value field-value--wide" id="observaciones" name="observaciones"
                    rows="3" placeholder="Observaciones adicionales del paso..."><%= v('observaciones') %></textarea>
        </div>
      </section>

      <%# Datos de fórmulas + stock embebidos para que el script abajo
           pueda renderizar la tabla sin AJAX. Vienen del controller. %>
      <script id="formulas-data" type="application/json"><%- typeof formulasJson !== 'undefined' ? formulasJson : '{}' %></script>
      <script id="stock-data"    type="application/json"><%- typeof stockMapJson !== 'undefined' ? stockMapJson : '{}' %></script>

      <!-- Confirmaciones previas al inicio -->
      <section class="nuevo-confirmaciones">
        <p class="nuevo-confirmaciones__title">Confirmaciones previas al inicio</p>
        <div class="confirmaciones-grid">
          <label class="confirmacion-item">
            <input type="checkbox" name="confirmFormula" value="1" <%= checked('confirmFormula') %>>
            <span>Fórmula maestra aprobada y vigente</span>
          </label>
          <label class="confirmacion-item">
            <input type="checkbox" name="confirmMaterias" value="1" <%= checked('confirmMaterias') %>>
            <span>Materias primas disponibles en almacén</span>
          </label>
          <label class="confirmacion-item">
            <input type="checkbox" name="confirmEquipos" value="1" <%= checked('confirmEquipos') %>>
            <span>Equipos de producción habilitados</span>
          </label>
        </div>
      </section>

    </form>
  </div>

  <!-- ════════════ Columna derecha — Aside ════════════ -->
  <aside class="nuevo-aside">

    <!-- Instrucciones -->
    <div class="aside-card">
      <p class="aside-card__title">ⓘ Instrucciones</p>
      <ol class="instrucciones-list">
        <li>Completa todos los campos obligatorios.</li>
        <li>Selecciona la fórmula maestra del producto.</li>
        <li>Verifica disponibilidad de materias primas.</li>
        <li>Asigna al operario responsable.</li>
        <li>Confirma los campos previos al inicio.</li>
        <li>Pulsa <strong>Crear y asignar</strong> para iniciar el lote.</li>
      </ol>
    </div>

    <!-- Requisito regulatorio -->
    <div class="aside-card aside-regulatorio">
      <p class="aside-card__title aside-regulatorio__title">⚠ Requisito regulatorio</p>
      <p class="aside-regulatorio__text">
        La orden creada queda registrada en la bitácora PAYRMA y no puede eliminarse, solo anularse.
      </p>
    </div>

    <!-- Botones de acción -->
    <div class="nuevo-actions">
      <button type="submit" form="nuevoForm" class="btn-accion btn-accion--primary">
        Crear y asignar orden →
      </button>
      <a href="<%= typeof dashboardPath !== 'undefined' ? dashboardPath : '/panel' %>" class="btn-accion btn-accion--cancel">Cancelar</a>
    </div>

  </aside>

</div>

<style>
  /* ── Layout principal ─────────────────────────────────────── */
  .nuevo-layout {
    display: flex;
    gap: var(--sp5);
    padding: var(--sp5);
    align-items: flex-start;
    flex: 1;
  }
  .nuevo-main  { flex: 1; min-width: 0; }
  .nuevo-aside {
    width: 290px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp3);
    position: sticky;
    top: var(--sp4);
  }

  /* ── Cabecera de página ───────────────────────────────────── */
  .nuevo-titulo {
    font-size: 18px;
    font-weight: var(--fw-medium);
    color: var(--text);
    border-bottom: 2px solid var(--green-dark);
    padding-bottom: var(--sp2);
    margin-bottom: var(--sp2);
    display: inline-block;
  }
  .nuevo-subtitulo {
    font-size: var(--fs-label);
    color: var(--muted);
    margin-bottom: var(--sp5);
  }

  /* ── Errores ──────────────────────────────────────────────── */
  .nuevo-errores {
    background: rgba(226, 75, 74, 0.06);
    border: 0.5px solid rgba(226, 75, 74, 0.3);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: var(--fs-label);
    color: #C42E2D;
    margin-bottom: var(--sp4);
  }
  .nuevo-errores ul { margin: 6px 0 0 18px; }

  /* ── Secciones numeradas ──────────────────────────────────── */
  .nuevo-seccion         { margin-bottom: var(--sp6); }
  .nuevo-seccion__head   {
    display: flex; align-items: center; gap: var(--sp2);
    margin-bottom: var(--sp2);
  }
  .nuevo-seccion__num    {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--green-dark);
    color: var(--white);
    font-size: var(--fs-hint);
    font-weight: var(--fw-medium);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .nuevo-seccion__titulo {
    font-size: 14px;
    font-weight: var(--fw-medium);
    color: var(--text);
  }
  .nuevo-seccion__hint   {
    font-size: var(--fs-label);
    color: var(--muted);
    margin-bottom: var(--sp4);
  }

  /* ── Fórmula maestra (preview de la fórmula del producto) ──── */
  .formula-empty {
    padding: 14px 16px;
    background: var(--input-bg, #f6f4ee);
    border: 0.5px dashed var(--border);
    border-radius: 10px;
  }

  .formula-tabla-wrap {
    background: var(--white);
    border: 0.5px solid var(--border);
    border-radius: 10px;
    padding: 4px 12px;
  }

  /* Pills de estado en la tabla */
  .estado-pill {
    display: inline-flex; align-items: center;
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 500;
  }
  .estado-pill--ok {
    background: rgba(93, 202, 165, 0.15);
    border: 0.5px solid var(--green-mid);
    color: var(--green-dark);
  }
  .estado-pill--warn {
    background: rgba(232, 240, 85, 0.35);
    border: 0.5px solid #c5c930;
    color: #555800;
  }
  .estado-pill--alert {
    background: rgba(226, 75, 74, 0.10);
    border: 0.5px solid #E24B4A;
    color: #C42E2D;
  }

  /* ── Confirmaciones (checkboxes en grid) ──────────────────── */
  .nuevo-confirmaciones {
    margin-top: var(--sp4);
    padding-top: var(--sp4);
    border-top: 0.5px solid var(--border);
  }
  .nuevo-confirmaciones__title {
    font-size: var(--fs-label);
    color: var(--text);
    font-weight: var(--fw-medium);
    margin-bottom: var(--sp3);
  }
  .confirmaciones-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp3);
  }
  .confirmacion-item {
    display: flex; align-items: center; gap: 8px;
    font-size: var(--fs-label);
    color: var(--text);
    cursor: pointer;
  }
  .confirmacion-item input[type="checkbox"] {
    width: 14px; height: 14px;
    accent-color: var(--green-dark);
    cursor: pointer;
    flex-shrink: 0;
  }

  /* ── Aside ────────────────────────────────────────────────── */
  .instrucciones-list {
    margin: 0; padding-left: 18px;
    display: flex; flex-direction: column; gap: 4px;
    font-size: var(--fs-label);
    color: var(--text);
    line-height: 1.5;
  }
  .instrucciones-list li::marker { color: var(--green-dark); font-weight: 500; }

  .aside-regulatorio {
    background: rgba(232, 240, 85, 0.18);
    border-color: #c5c930;
  }
  .aside-regulatorio__title { color: #555800; }
  .aside-regulatorio__text {
    font-size: var(--fs-label);
    color: #555800;
    line-height: 1.5;
  }

  /* ── Botones de acción ────────────────────────────────────── */
  .nuevo-actions {
    display: flex; flex-direction: column; gap: var(--sp2);
    margin-top: var(--sp2);
  }
  .btn-accion {
    display: flex; align-items: center; justify-content: center;
    height: 42px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: var(--fw-medium);
    text-decoration: none;
    cursor: pointer;
    border: 0.5px solid transparent;
    transition: opacity 0.15s, background 0.15s;
    width: 100%;
    font-family: var(--font);
  }
  .btn-accion--primary {
    background: var(--green-dark);
    color: var(--white);
    border-color: var(--green-dark);
  }
  .btn-accion--primary:hover { opacity: 0.92; }

  .btn-accion--secondary {
    background: var(--white);
    color: var(--green-dark);
    border-color: var(--border);
  }
  .btn-accion--secondary:hover { background: var(--input-bg); }

  .btn-accion--cancel {
    background: rgba(226, 75, 74, 0.85);
    color: var(--white);
    border-color: rgba(226, 75, 74, 0.85);
  }
  .btn-accion--cancel:hover { background: rgba(226, 75, 74, 1); }

  /* ── Responsivo ───────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .nuevo-layout { flex-direction: column; }
    .nuevo-aside { width: 100%; position: static; }
    .confirmaciones-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Preview dinámico de la fórmula maestra cuando el DT elige producto.
  // No hace AJAX: las fórmulas y el stock vienen embebidos como JSON
  // desde el controller (script#formulas-data y script#stock-data).
  (function() {
    const formulas = JSON.parse(document.getElementById('formulas-data').textContent || '{}');
    const stock    = JSON.parse(document.getElementById('stock-data').textContent || '{}');
    const sel      = document.getElementById('formulaId');
    const empty    = document.getElementById('formula-empty');
    const content  = document.getElementById('formula-content');
    const tbody    = document.getElementById('formula-mp-body');

    function pillEstado(estado) {
      if (estado === 'agotado') return '<span class="estado-pill estado-pill--alert">Agotado</span>';
      if (estado === 'bajo')    return '<span class="estado-pill estado-pill--warn">Stock bajo</span>';
      if (estado === 'ok')      return '<span class="estado-pill estado-pill--ok">Disponible</span>';
      return '<span class="estado-pill" style="background:var(--input-bg);color:var(--muted);">No catalogada</span>';
    }

    function pintarFormula(prod) {
      const f = formulas[prod];
      if (!f || !f.paso2 || !Array.isArray(f.paso2.materias)) {
        empty.style.display = 'block';
        content.style.display = 'none';
        return;
      }
      empty.style.display = 'none';
      content.style.display = 'block';
      tbody.innerHTML = f.paso2.materias.map(function(mp) {
        const st = stock[mp.codigo];
        const estado = st ? st.estado : null;
        const rango = (mp.min !== undefined && mp.max !== undefined)
          ? (mp.min + '–' + mp.max + ' ' + (mp.espUnidad || ''))
          : '—';
        return '<tr>'
          + '<td>' + mp.nombre + ' <span style="color:var(--muted); font-size:10px;">(' + (mp.codigo || '') + ')</span></td>'
          + '<td>' + mp.espNum + '</td>'
          + '<td>' + (mp.espUnidad || '') + '</td>'
          + '<td style="font-size:11px; color:var(--muted);">' + rango + '</td>'
          + '<td>' + pillEstado(estado) + '</td>'
          + '</tr>';
      }).join('');
    }

    // Estado inicial: si el form viene re-renderizado con un producto
    // seleccionado (caso error), mostramos su fórmula. Si no, vacío.
    if (sel) {
      sel.addEventListener('change', function() { pintarFormula(sel.value); });
      if (sel.value) pintarFormula(sel.value);
    }
  })();
</script>
