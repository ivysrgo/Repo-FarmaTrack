  <!-- ════════════ Columna izquierda — Formulario ════════════ -->
  <div class="nuevo-main">

    <h1 class="nuevo-titulo">Nueva orden de producción</h1>
    <p class="nuevo-subtitulo">Completa los campos para iniciar el ciclo de vida del lote en el sistema.</p>

    <% if (typeof errores !== 'undefined' && errores.length > 0) { %>
      <div class="nuevo-errores">
        <strong>Corrige los siguientes errores:</strong>
        <ul>
          <% errores.forEach(function(e){ %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <%
      // Helper para preservar valores en re-render
      function v(k, def) {
        if (typeof values === 'undefined' || values == null) return def || '';
        return (values[k] !== undefined && values[k] !== null) ? values[k] : (def || '');
      }
      function checked(k) {
        if (typeof values === 'undefined' || values == null) return '';
        return values[k] ? 'checked' : '';
      }
    %>

    <form action="/lotes/nuevo" method="POST" id="nuevoForm" novalidate>

      <!-- ① Datos generales del lote -->
      <section class="nuevo-seccion">
        <header class="nuevo-seccion__head">
          <span class="nuevo-seccion__num">1</span>
          <h2 class="nuevo-seccion__titulo">Datos generales del lote</h2>
        </header>
        <p class="nuevo-seccion__hint">Completa todos los campos para iniciar el ciclo de vida del lote en el sistema.</p>

        <div class="field-grid field-grid--2" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="numeroOrden">Número de orden de producción</label>
            <input class="field-value" type="text" id="numeroOrden" name="numeroOrden"
                   placeholder="Ej: OP-2026-001" value="<%= v('numeroOrden') %>" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="codigoLote">Código de lote asignado</label>
            <input class="field-value" type="text" id="codigoLote" name="codigoLote"
                   placeholder="Ej: LT-2026-090" value="<%= v('codigoLote') %>" required>
          </div>
        </div>

        <div class="field-grid" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="producto">Producto a fabricar</label>
            <input class="field-value" type="text" id="producto" name="producto"
                   placeholder="Escribe el nombre del producto..." value="<%= v('producto') %>" required>
          </div>
        </div>

        <div class="field-grid field-grid--3" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="cantidad">Cantidad planificada (unid.)</label>
            <input class="field-value" type="number" id="cantidad" name="cantidad"
                   placeholder="Ej: 5000" min="100" value="<%= v('cantidad') %>" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="formaFarmaceutica">Forma farmacéutica</label>
            <input class="field-value" type="text" id="formaFarmaceutica" name="formaFarmaceutica"
                   placeholder="Ej: Tabletas" value="<%= v('formaFarmaceutica') %>">
          </div>
          <div class="field-group">
            <label class="field-label" for="concentracion">Concentración</label>
            <input class="field-value" type="text" id="concentracion" name="concentracion"
                   placeholder="Ej: 500mg" value="<%= v('concentracion') %>">
          </div>
        </div>

        <div class="field-grid field-grid--2">
          <div class="field-group">
            <label class="field-label" for="fechaInicio">Fecha de inicio planificada</label>
            <input class="field-value" type="date" id="fechaInicio" name="fechaInicio"
                   value="<%= v('fechaInicio') %>" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="fechaFin">Fecha estimada de fin</label>
            <input class="field-value" type="date" id="fechaFin" name="fechaFin"
                   value="<%= v('fechaFin') %>">
          </div>
        </div>
      </section>

      <!-- ② Responsables asignados -->
      <section class="nuevo-seccion">
        <header class="nuevo-seccion__head">
          <span class="nuevo-seccion__num">2</span>
          <h2 class="nuevo-seccion__titulo">Responsables asignados</h2>
        </header>

        <div class="field-grid field-grid--2" style="margin-bottom:var(--sp3);">
          <div class="field-group">
            <label class="field-label" for="directorTecnico">Director Técnico responsable</label>
            <input class="field-value" type="text" id="directorTecnico" name="directorTecnico"
                   value="<%= v('directorTecnico', usuario.nombre || 'Director Técnico') %>" readonly
                   style="background:var(--input-bg); color:var(--text);">
          </div>
          <div class="field-group">
            <label class="field-label" for="operario">Operario de producción</label>
            <select class="field-value" id="operario" name="operario" required>
              <option value="">Selecciona operario...</option>
              <% ['Carlos Rodríguez','Luisa Martínez','Andrés Gómez','María Torres','Felipe Díaz','Valentina Cruz'].forEach(function(op) { %>
                <option value="<%= op %>" <%= v('operario') === op ? 'selected' : '' %>><%= op %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="field-grid field-grid--2">
          <div class="field-group">
            <label class="field-label" for="jefeCalidad">Jefe de calidad asignado</label>
            <select class="field-value" id="jefeCalidad" name="jefeCalidad" required>
              <option value="">Selecciona jefe de calidad...</option>
              <% ['Patricia Henao','Roberto Vega','Sofía Restrepo'].forEach(function(jc) { %>
                <option value="<%= jc %>" <%= v('jefeCalidad') === jc ? 'selected' : '' %>><%= jc %></option>
              <% }); %>
            </select>
          </div>
          <div class="field-group">
            <label class="field-label" for="area">Área de producción</label>
            <select class="field-value" id="area" name="area" required>
              <option value="">Selecciona área...</option>
              <% ['Sólidos — Línea 1','Sólidos — Línea 2','Líquidos — Línea 1','Semisólidos — Línea 1'].forEach(function(a) { %>
                <option value="<%= a %>" <%= v('area') === a ? 'selected' : '' %>><%= a %></option>
              <% }); %>
            </select>
          </div>
        </div>
      </section>

      <!-- ③ Fórmula maestra -->
      <section class="nuevo-seccion">
        <header class="nuevo-seccion__head">
          <span class="nuevo-seccion__num">3</span>
          <h2 class="nuevo-seccion__titulo">Fórmula maestra</h2>
        </header>

        <div class="formula-search">
          <input class="field-value" type="text" id="formulaMaestra" name="formulaMaestra"
                 placeholder="Selecciona o busca la fórmula maestra registrada..." value="<%= v('formulaMaestra') %>">
          <a href="#" class="formula-nueva" onclick="event.preventDefault();">+ Nueva fórmula</a>
        </div>

        <div class="formula-tabla-wrap">
          <table class="step-table">
            <thead>
              <tr>
                <th>Materia prima</th>
                <th>Cantidad</th>
                <th>Unidad</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Amoxicilina trihidrato</td>
                <td>2,500</td>
                <td>g</td>
                <td><span class="estado-pill estado-pill--ok">Disponible</span></td>
              </tr>
              <tr>
                <td>Celulosa microcristalina</td>
                <td>800</td>
                <td>g</td>
                <td><span class="estado-pill estado-pill--ok">Disponible</span></td>
              </tr>
              <tr>
                <td>Almidón de maíz</td>
                <td>400</td>
                <td>g</td>
                <td><span class="estado-pill estado-pill--warn">Stock bajo</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="field-group" style="margin-top:var(--sp4);">
          <label class="field-label" for="observaciones">Observaciones del paso</label>
          <textarea class="field-value field-value--wide" id="observaciones" name="observaciones"
                    rows="3" placeholder="Observaciones adicionales del paso..."><%= v('observaciones') %></textarea>
        </div>
      </section>

      <!-- Confirmaciones previas al inicio -->
      <section class="nuevo-confirmaciones">
        <p class="nuevo-confirmaciones__title">Confirmaciones previas al inicio</p>
        <div class="confirmaciones-grid">
          <label class="confirmacion-item">
            <input type="checkbox" name="confirmFormula" value="1" <%= checked('confirmFormula') %>>
            <span>Fórmula maestra aprobada y vigente</span>
          </label>
          <label class="confirmacion-item">
            <input type="checkbox" name="confirmMaterias" value="1" <%= checked('confirmMaterias') %>>
            <span>Materias primas disponibles en almacén</span>
          </label>
          <label class="confirmacion-item">
            <input type="checkbox" name="confirmEquipos" value="1" <%= checked('confirmEquipos') %>>
            <span>Equipos de producción habilitados</span>
          </label>
        </div>
      </section>
>>>>>>> d51e171 (CAmbios y Funcionalidades realizadas para FarmaTrack)

    </form>
  </div>

