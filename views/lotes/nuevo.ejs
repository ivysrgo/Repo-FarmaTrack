  <!-- ════════════ Columna derecha — Aside ════════════ -->
  <aside class="nuevo-aside">

    <!-- Instrucciones -->
    <div class="aside-card">
      <p class="aside-card__title">ⓘ Instrucciones</p>
      <ol class="instrucciones-list">
        <li>Completa todos los campos obligatorios.</li>
        <li>Selecciona la fórmula maestra del producto.</li>
        <li>Verifica disponibilidad de materias primas.</li>
        <li>Asigna al operario responsable.</li>
        <li>Confirma los campos previos al inicio.</li>
        <li>Pulsa <strong>Crear y asignar</strong> para iniciar el lote.</li>
      </ol>
    </div>

    <!-- Requisito regulatorio -->
    <div class="aside-card aside-regulatorio">
      <p class="aside-card__title aside-regulatorio__title">⚠ Requisito regulatorio</p>
      <p class="aside-regulatorio__text">
        La orden creada queda registrada en la bitácora PAYRMA y no puede eliminarse, solo anularse.
      </p>
    </div>

    <!-- Botones de acción -->
    <div class="nuevo-actions">
      <button type="submit" form="nuevoForm" class="btn-accion btn-accion--primary">
        Crear y asignar orden →
      </button>
      <button type="submit" form="nuevoForm" name="modoBorrador" value="1" class="btn-accion btn-accion--secondary"
              formnovalidate>
        Guardar borrador
      </button>
